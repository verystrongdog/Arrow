		"nodes": {
			"1": {
				"type": "entry",
				"name": "开始",
				"notes": "这一页是普通场景，只负责调用宏。正文不写在场景里。选中中间那个「使用宏」节点，检查器的下拉框指向「宏_打招呼」。宏里走到没有出口的节点时，会回到这个「使用宏」，再走它右边接到「回到场景」的线。",
				"data": { "plaque": "开始" }
			},
			"2": {
				"type": "content",
				"name": "进宏前",
				"data": {
					"title": "进宏之前",
					"content": "下一句不在这个场景里。播放会进入宏「宏_打招呼」的入口。"
				}
			},
			"3": {
				"type": "macro_use",
				"name": "调用打招呼",
				"data": { "macro": 5 }
			},
			"4": {
				"type": "content",
				"name": "回到场景",
				"data": {
					"title": "回到场景",
					"content": "宏里的两条分支都没有再往外接线，所以都会回到这里。宏的结尾就是「最后一块没有出口」。"
				}
			},
			"6": {
				"type": "entry",
				"name": "宏入口",
				"notes": "你现在在宏的画布上。往宏里加东西，就是在这块画布上加节点：右键空白处插入，或点底栏「加对话」「加交互」「加内容」。它们顺着入口的第一条出口往下找，接到最后一块上。宏里不能再放「使用宏」。",
				"data": { "plaque": "宏入口" }
			},
			"7": {
				"type": "dialog",
				"name": "旅人的两句话",
				"data": {
					"character": 10,
					"lines": ["路上小心。", "需要补给吗？"],
					"playable": true
				}
			},
			"8": {
				"type": "content",
				"name": "小心",
				"data": {
					"title": "小心",
					"content": "这句写在宏里面。它是对话第一条线（针脚 1）接出来的。没有下一段，于是交还给出场景。"
				}
			},
			"9": {
				"type": "content",
				"name": "补给",
				"data": {
					"title": "补给",
					"content": "这句也写在宏里面，接在对话的第二条线上。底栏「加对话」只会顺着第一条线往下接；要接到这一条，从这句右边的针脚拖到空白处。"
				}
			}
		},
